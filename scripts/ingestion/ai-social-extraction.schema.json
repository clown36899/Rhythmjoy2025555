{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "poster_text", "events", "reasons"],
  "properties": {
    "decision": { "type": "string", "enum": ["extract", "review", "none"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "poster_text": { "type": "string" },
    "events": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "event_date", "venue", "djs", "poster_image_index", "evidence_quotes"],
        "properties": {
          "title": { "type": "string", "minLength": 4 },
          "event_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "venue": { "type": "string", "minLength": 2 },
          "djs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "poster_image_index": { "type": "integer", "minimum": 0, "maximum": 3 },
          "evidence_quotes": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 2 } }
        }
      }
    },
    "reasons": { "type": "array", "items": { "type": "string" } }
  }
}
