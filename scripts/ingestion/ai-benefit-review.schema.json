{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "benefit_kind", "category", "activity_type", "active_on_today", "validity_end_date", "title", "venue", "evidence_quotes", "reasons"],
  "properties": {
    "decision": { "type": "string", "enum": ["accept", "review", "reject"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "benefit_kind": { "type": ["string", "null"], "enum": ["free_event", "discount_event", "season_pass", null] },
    "category": { "type": ["string", "null"], "enum": ["social", "class", "event", "club", null] },
    "activity_type": { "type": ["string", "null"], "enum": ["social", "class", "event", "recruit", "sale", null] },
    "active_on_today": { "type": ["boolean", "null"] },
    "validity_end_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": ["string", "null"] },
    "venue": { "type": ["string", "null"] },
    "evidence_quotes": { "type": "array", "items": { "type": "string", "minLength": 2 } },
    "reasons": { "type": "array", "items": { "type": "string" } }
  }
}
