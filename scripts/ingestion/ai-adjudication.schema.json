{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "confidence", "event_date", "activity_type", "venue", "djs", "evidence_quotes", "reasons"],
  "properties": {
    "decision": { "type": "string", "enum": ["register", "review", "reject"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "event_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "activity_type": { "type": ["string", "null"], "enum": ["social", "class", "event", "recruit", "sale", null] },
    "venue": { "type": ["string", "null"] },
    "djs": { "type": "array", "items": { "type": "string" } },
    "evidence_quotes": { "type": "array", "items": { "type": "string", "minLength": 2 } },
    "reasons": { "type": "array", "items": { "type": "string" } }
  }
}
