<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rhythmjoy.social-reel-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-dimsu</string>
    <string>__NODE_PATH__</string>
    <string>__REPOSITORY_ROOT__/scripts/social-reels/run-scheduled-social-reel.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPOSITORY_ROOT__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>2</integer>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>6</integer>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
    <key>TZ</key>
    <string>Asia/Seoul</string>
    <key>RHYTHMJOY_SOCIAL_REEL_ENV</key>
    <string>__USER_HOME__/.rhythmjoy-ingestion.env</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__USER_HOME__/social-reel-runs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/social-reel-runs/launchd.log</string>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LowPriorityIO</key>
  <false/>
  <key>ExitTimeOut</key>
  <integer>30</integer>
</dict>
</plist>
